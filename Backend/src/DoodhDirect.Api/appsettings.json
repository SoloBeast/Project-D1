{
  "Authentication": {
    "Jwt": {
      "Issuer": "DoodhDirect.Api",
      "Audience": "DoodhDirect.App",
      "SigningKey": "CONFIGURE_A_SECRET_OF_AT_LEAST_32_CHARACTERS",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "Identity": {
      "OtpLifetimeMinutes": 5,
      "OtpMaxAttempts": 5,
      "OtpRequestsPerWindow": 3,
      "OtpRateLimitWindowMinutes": 15,
      "PasswordIterations": 120000
    }
  },
  "Payments": {
    "Provider": "Razorpay",
    "Currency": "INR",
    "PaymentExpiryMinutes": 15,
    "RazorpayKeyId": "",
    "RazorpayKeySecret": "",
    "RazorpayWebhookSecret": "",
    "MockSigningSecret": "CONFIGURE_A_DEVELOPMENT_ONLY_MOCK_SECRET"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}