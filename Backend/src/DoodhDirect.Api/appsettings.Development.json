{
  "TimeZone": "Asia/Kolkata",
  "ConnectionStrings": {
    "DoodhDirect": "Server=.\\SQLEXPRESS;Database=DoodhDirect;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Payments": {
    "Provider": "Razorpay",
    "Currency": "INR",
    "PaymentExpiryMinutes": 15
  },
  "Deliveries": {
    "SubscriptionGenerationWindowDays": 31
  },
  "AddressGeocoding": {
    "Provider": "Google",
    "ApiKey": "",
    "WebClientApiKey": "",
    "BaseUrl": "https://maps.googleapis.com/maps/api/geocode/json",
    "TimeoutSeconds": 10
  },
  "CameraStreams": {
    "Provider": "Unconfigured",
    "DevelopmentHlsPlaybackUrl": null,
    "DescriptorLifetimeMinutes": 5
  },
  "Notifications": {
    "BatchSize": 25,
    "MaxAttempts": 4,
    "PollIntervalSeconds": 2,
    "InitialRetryDelayMinutes": 1,
    "PushProvider": "Unconfigured",
    "SmsProvider": "Unconfigured",
    "WhatsAppProvider": "Unconfigured",
    "EmailProvider": "Unconfigured"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:51482",
      "http://127.0.0.1:51482"
    ]
  },
  "SeedOptions": {
    "EnableDevelopmentSeeds": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DoodhDirect.Infrastructure.OtpProvider.Msg91ApiClient": "Debug"
    }
  }
}