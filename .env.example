# DoodhDirect local Development configuration template.
#
# Copy this file to `.env` and fill in the local values. The repository
# `.gitignore` excludes `.env` and `.env.*`; only this `.env.example` is
# tracked. Never commit real keys or secrets.
#
# The Development launcher (`scripts/run-flutter-web-development.ps1`) reads
# only the Google Maps key below from `.env`. It never loads Razorpay values or
# any other backend secret, and it never prints the value.

# Local Google Maps browser key for the Web Development client.
# Must be restricted to the exact local origin used by the launcher (default
# http://localhost:51482/) via Websites / HTTP referrers, and API-restricted
# to the Maps JavaScript API.
DOOHDIRECT_GOOGLE_MAPS_API_KEY=
